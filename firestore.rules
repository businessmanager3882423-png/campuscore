
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'active';
    }

    function isPrincipal() {
      return activeUser() && myProfile().role == 'principal';
    }

    function isTeacher() {
      return activeUser() && myProfile().role == 'teacher';
    }

    function isStudent() {
      return activeUser() && myProfile().role == 'student';
    }

    function validRole(role) {
      return role in ['principal', 'teacher', 'student'];
    }

    function assignedTeacher(classId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds;
    }

    function enrolledStudent(classId) {
      return isStudent()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.studentIds;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email;

      allow get: if activeUser()
        && (request.auth.uid == uid || isPrincipal()
          || (isTeacher()
            && resource.data.role == 'student'));

      allow list: if isPrincipal()
        || (isTeacher() && resource.data.role == 'student');

      allow update: if isPrincipal()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && validRole(request.resource.data.role)
        && request.resource.data.status in ['active', 'suspended'];

      allow update: if activeUser()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'program', 'semester', 'updatedAt']);

      allow delete: if isPrincipal();
    }

    match /classes/{classId} {
      allow read: if isPrincipal()
        || assignedTeacher(classId)
        || enrolledStudent(classId);

      allow create, update, delete: if isPrincipal();
    }

    match /tasks/{taskId} {
      allow read: if isPrincipal()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && request.auth.uid in resource.data.studentIds);

      allow create: if isPrincipal()
        || (assignedTeacher(request.resource.data.classId)
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid);

      allow update: if isPrincipal()
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.createdBy == resource.data.createdBy);

      allow update: if isStudent()
        && request.auth.uid in resource.data.studentIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['submissions', 'updatedAt'])
        && request.resource.data.submissions[request.auth.uid] is map;

      allow delete: if isPrincipal()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /attendance/{attendanceId} {
      allow read: if isPrincipal()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if isPrincipal()
        || (assignedTeacher(request.resource.data.classId)
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.status in ['present', 'absent', 'late', 'leave']);

      allow update: if isPrincipal()
        || (assignedTeacher(resource.data.classId)
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.classId == resource.data.classId);

      allow delete: if isPrincipal();
    }

    match /notices/{noticeId} {
      allow read: if activeUser()
        && (isPrincipal()
          || resource.data.audience == 'all'
          || (isTeacher() && resource.data.audience == 'teacher')
          || (isStudent() && resource.data.audience == 'student'));

      allow create, update, delete: if isPrincipal();
    }

    match /exams/{examId} {
      allow read: if isPrincipal()
        || (isTeacher() && assignedTeacher(resource.data.classId))
        || (isStudent() && enrolledStudent(resource.data.classId));

      allow create, update, delete: if isPrincipal();
    }

    match /fees/{feeId} {
      allow read: if isPrincipal()
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create, update, delete: if isPrincipal();
    }

    match /auditLogs/{logId} {
      allow read: if isPrincipal();
      allow create: if activeUser()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
